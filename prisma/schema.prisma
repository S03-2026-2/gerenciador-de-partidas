generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusPartida {
  AGUARDANDO_BATALHA
  EM_BATALHA
  FINALIZADA
}

model Partida {
  id                String        @id
  idJogador1        String
  idJogador2        String
  dataCriacao       DateTime      @default(now())
  status            StatusPartida
  idVencedor        String?
  idPerdedor        String?
  pontuacaoJogador1 Int?
  pontuacaoJogador2 Int?
  detalhes          String?
}
